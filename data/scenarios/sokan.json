 "events": [
  {
   "id": "modu",
   "y": 209,
   "m": 3,
   "need": [
    "xiongnu"
   ],
   "do": [
    [
     "rulerDies",
     "xiongnu",
     "assassination"
    ],
    [
     "add",
     "xiongnu",
     "prestige",
     15
    ]
   ],
   "imp": 2,
   "at": "xiongnu",
   "ja": "匈奴の太子冒頓は、自分の鳴鏑の射る先へ必ず射よと部下を鍛え、ついに父の頭曼単于を射させて単于となった。",
   "en": "Modu, heir of the Xiongnu, trained his men to shoot wherever his whistling arrow flew — and at last had them shoot his father, Touman Chanyu. He became chanyu himself."
  },
  {
   "id": "dazexiang",
   "y": 209,
   "m": 8,
   "need": [
    "qin"
   ],
   "do": [
    [
     "rise",
     "zhangchu",
     [
      "chen",
      "dazexiang"
     ]
    ],
    [
     "add",
     "qin",
     "stability",
     -0.2
    ]
   ],
   "imp": 3,
   "at": "dazexiang",
   "ja": "大沢郷の乱。北の守りへ送られる途中、大雨で期日に遅れて死罪が決まった陳勝・呉広は「王侯将相いずくんぞ種あらんや」と叫んで兵を挙げ、陳で王を称して国を張楚と号した。",
   "en": "The rising at Dazexiang. On their way to the northern frontier, held up by rain and so condemned to death for being late, Chen Sheng and Wu Guang cried \"Are kings and generals born to it?\" and rose. Chen Sheng made himself king at Chen and called his realm Zhang Chu."
  },
  {
   "id": "zhao_rise",
   "y": 209,
   "m": 9,
   "need": [
    "qin"
   ],
   "do": [
    [
     "rise",
     "zhao",
     [
      "handan",
      "julu",
      "xiangguo"
     ]
    ]
   ],
   "at": "handan",
   "ja": "陳勝の部将武臣は北の趙の地を平らげ、邯鄲で自ら趙王を称した。",
   "en": "Wu Chen, a captain of Chen Sheng, took the old land of Zhao in the north and made himself King of Zhao at Handan."
  },
  {
   "id": "liu_rise",
   "y": 209,
   "m": 10,
   "need": [
    "qin"
   ],
   "do": [
    [
     "rise",
     "liu",
     [
      "pei"
     ]
    ]
   ],
   "imp": 3,
   "at": "pei",
   "ja": "沛の亭長だった劉邦は、県令を殺した沛の人々に推されて立ち、「沛公」と呼ばれた。",
   "en": "Liu Bang, once a village constable of Pei, was put forward by the townsmen after they killed their magistrate, and was called the Lord of Pei."
  },
  {
   "id": "chu_rise",
   "y": 209,
   "m": 10,
   "need": [
    "qin"
   ],
   "do": [
    [
     "rise",
     "chu",
     [
      "kuaiji"
     ]
    ]
   ],
   "imp": 3,
   "at": "kuaiji",
   "ja": "楚の名将項燕の子項梁は、甥の項羽とともに会稽の郡守を斬って兵を挙げた。二十四歳の項羽は、その日だけで数十人を斬ったという。",
   "en": "Xiang Liang, son of the great Chu general Xiang Yan, rose with his nephew Xiang Yu by cutting down the governor of Kuaiji; Xiang Yu, twenty-four, is said to have killed scores that day alone."
  },
  {
   "id": "yan_qi_rise",
   "y": 209,
   "m": 10,
   "need": [
    "qin"
   ],
   "do": [
    [
     "rise",
     "yan",
     [
      "ji",
      "dai"
     ]
    ],
    [
     "rise",
     "qi",
     [
      "linzi",
      "jimo",
      "boyang"
     ]
    ]
   ],
   "at": "linzi",
   "ja": "燕では韓広が燕王を称し、斉では旧王族の田儋が県令を殺して斉王を称した。",
   "en": "In Yan, Han Guang declared himself King of Yan; in Qi, Tian Dan of the old royal house killed the magistrate and declared himself King of Qi."
  },
  {
   "id": "wei_rise",
   "y": 208,
   "m": 1,
   "need": [
    "qin"
   ],
   "do": [
    [
     "rise",
     "wei",
     [
      "daliang",
      "dingtao"
     ]
    ]
   ],
   "at": "daliang",
   "ja": "魏の旧王族魏咎が魏王に立てられた。",
   "en": "Wei Jiu of the old royal house of Wei was set up as King of Wei."
  },
  {
   "id": "chen_sheng_end",
   "y": 208,
   "m": 1,
   "need": [
    "zhangchu",
    "chu"
   ],
   "do": [
    [
     "annex",
     "chu",
     "zhangchu"
    ]
   ],
   "imp": 3,
   "at": "chen",
   "ja": "秦将章邯に敗れて逃げる陳勝は、御者の荘賈に殺された。蜂起からわずか半年であった。反乱の旗は楚の項梁へ移った。",
   "en": "Beaten by the Qin general Zhang Han, Chen Sheng was killed in flight by his own charioteer, barely half a year after the rising. The banner of revolt passed to Xiang Liang of Chu."
  },
  {
   "id": "hank_rise",
   "y": 208,
   "m": 6,
   "need": [
    "qin"
   ],
   "do": [
    [
     "rise",
     "hank",
     [
      "yangzhai"
     ]
    ]
   ],
   "at": "yangzhai",
   "ja": "張良の勧めで韓の旧王族韓成が韓王に立てられた。",
   "en": "At Zhang Liang's urging, Han Cheng of the old royal house of Hann was set up as its king."
  },
  {
   "id": "king_huai",
   "y": 208,
   "m": 7,
   "need": [
    "chu"
   ],
   "do": [
    [
     "add",
     "chu",
     "legitimacy",
     0.3
    ],
    [
     "capital",
     "chu",
     "xuyi"
    ]
   ],
   "imp": 2,
   "at": "xuyi",
   "ja": "項梁は范増の献策を容れ、羊飼いをしていた楚の王族の孫心を探し出して楚の懐王に立てた。",
